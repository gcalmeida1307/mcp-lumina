{
  "name": "lumina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --use-system-ca node_modules/tsx/dist/cli.mjs watch gateway/server.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --use-system-ca node_modules/tsx/dist/cli.mjs watch gateway/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-system-ca node_modules/tsx/dist/cli.mjs gateway/server.ts",
    "test": "node --use-system-ca node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "benchmark:knowledge": "node --use-system-ca node_modules/tsx/dist/cli.mjs scripts/benchmark-knowledge.ts",
    "eval": "node --use-system-ca node_modules/tsx/dist/cli.mjs core/llmops/evaluate.ts",
    "start:lan": "node scripts/lan-server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@xyflow/react": "^12.11.6",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "exceljs": "^3.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "framer-motion": "^13.4.2",
    "helmet": "^8.0.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.0",
    "oidc-client-ts": "^3.0.0",
    "pdf-parse": "^2.0.0",
    "pg": "^8.0.0",
    "prom-client": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^5.0.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

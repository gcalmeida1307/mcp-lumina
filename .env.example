# Postgres
POSTGRES_USER=lumina
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumina
DATABASE_URL=postgresql://lumina:change-me@127.0.0.1:5432/lumina

# MinIO
MINIO_ROOT_USER=sofia
MINIO_ROOT_PASSWORD=sofia_minio_secret

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/lumina
OIDC_JWKS_URL=http://localhost:8080/realms/lumina/protocol/openid-connect/certs
OIDC_AUDIENCE=lumina-api
OIDC_CLIENT_ID=lumina-web

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Limites de processamento documental
MAX_DOCUMENT_CHARS=60000000
MAX_DOCUMENT_CHUNKS=60000

# Provedor de geração: openai, anthropic ou ollama
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# Alternativa local: selecione LLM_PROVIDER=ollama e o nome de um modelo instalado.
# Não exige LLM_API_KEY e não usa fallback automático para nuvem.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
